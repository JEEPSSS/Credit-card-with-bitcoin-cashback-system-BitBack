# Leave DATABASE_URL unset to use SQLite with zero setup.
# DATABASE_URL=postgresql://user:password@localhost:5432/bitback

# "production" refuses to start unless SECRET_KEY is set (32+ bytes), DEMO_MODE
# is false, and DATABASE_URL is not SQLite.
ENVIRONMENT=development

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-of-32-bytes-or-more
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Returns password-reset tokens in the API response so the flow can be
# demonstrated without an email provider. Turn this off outside a demo: it hands
# an account takeover to anyone who knows an email address.
DEMO_MODE=true

# Comma-separated, or leave as ["*"] for LAN device testing.
# CORS_ORIGINS=["https://bitback.example"]

# Where rate limits read the caller's address from: direct, x-forwarded-for, or
# cf-connecting-ip. Check a deployment with GET /api/meta/client-ip (DEPLOY.md).
CLIENT_IP_SOURCE=x-forwarded-for

# Rewards are declined in production if the live BTC price is older than this.
BTC_PRICE_MAX_AGE_SECONDS=1800

# Password-reset email through Resend (resend.com). Set all three or none:
# production refuses to start with only some of them. Unset, the forgot-password
# screen says emailed resets are unavailable instead of promising a link.
# EMAIL_FROM must use a domain verified in Resend; PUBLIC_BASE_URL is this
# server's https address, which the emailed link opens (/reset-password).
# RESEND_API_KEY=
# EMAIL_FROM=BitBack <no-reply@example.com>
# PUBLIC_BASE_URL=https://bitback-xyz.onrender.com

# Contact address shown on /privacy. Unset, the page points at the store listing.
# SUPPORT_EMAIL=

# Transactions a user accumulates before the fraud model is refit. Scoring runs
# on every transaction regardless; only training is deferred.
FRAUD_REFIT_INTERVAL=25
